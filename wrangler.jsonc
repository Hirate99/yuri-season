{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yuri-season-radar",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "ADMIN_TOKEN",
      "BETTER_AUTH_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yuri-season-radar",
      "database_id": "d12ef7cf-5632-4a43-ba4c-d0fddb4915f4",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "send_email": [{ "name": "EMAIL" }],
  "assets": {
    "run_worker_first": ["/api/*", "/robots.txt", "/sitemap.xml"]
  },
  "vars": {
    "BETTER_AUTH_URL": "https://i-yuri.com",
    "AUTH_EMAIL_FROM": "noreply@i-yuri.com",
    "UPDATE_MODE": "local-first",
    "DEPLOYMENT_ROLE": "public",
    "ADMIN_ORIGIN": "https://i-yuri.com",
    "ACCESS_TEAM_DOMAIN": "mskyurina.cloudflareaccess.com",
    "ACCESS_AUD": "007d1a337caf11efc5466da44714e15d98f2fa7b835763748cdde6e00ebee634",
    "ADMIN_EMAILS": "haonan.su@outlook.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "upload_source_maps": true,
  "env": {
    "test": {
      "name": "yuri-season-radar-test",
      "secrets": { "required": ["ADMIN_TOKEN", "BETTER_AUTH_SECRET"] },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "yuri-season-radar-test",
        "database_id": "00000000-0000-4000-8000-000000000001",
        "migrations_dir": "migrations"
      }],
      "send_email": [{ "name": "EMAIL", "remote": false }],
      "vars": {
        "UPDATE_MODE": "local-first",
        "DEPLOYMENT_ROLE": "test",
        "ADMIN_ORIGIN": "http://127.0.0.1:4317",
        "BETTER_AUTH_URL": "http://127.0.0.1:4317",
        "AUTH_EMAIL_FROM": "noreply@example.test",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "ADMIN_EMAILS": ""
      }
    },
    "admin": {
      "name": "yuri-season-radar-admin",
      "secrets": {
        "required": [
          "ADMIN_TOKEN"
        ]
      },
      "routes": [
        {
          "pattern": "i-yuri.com/admin*",
          "zone_name": "i-yuri.com"
        },
        {
          "pattern": "i-yuri.com/api/admin*",
          "zone_name": "i-yuri.com"
        },
        {
          "pattern": "i-yuri.com/admin-assets*",
          "zone_name": "i-yuri.com"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "yuri-season-radar",
          "database_id": "d12ef7cf-5632-4a43-ba4c-d0fddb4915f4",
          "migrations_dir": "migrations"
        }
      ],
      "ai": {
        "binding": "AI",
        "remote": true
      },
      "vars": {
        "UPDATE_MODE": "local-first",
        "DEPLOYMENT_ROLE": "admin",
        "ADMIN_ORIGIN": "https://i-yuri.com",
        "ACCESS_TEAM_DOMAIN": "mskyurina.cloudflareaccess.com",
        "ACCESS_AUD": "007d1a337caf11efc5466da44714e15d98f2fa7b835763748cdde6e00ebee634",
        "ADMIN_EMAILS": "haonan.su@outlook.com"
      }
    }
  }
}
